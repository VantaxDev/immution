[Unit]
Description=Immution Apache log analyzer
Documentation=https://www.immution.com/
After=apache2.service

[Service]
Type=simple
User=immution
Group=www-data
SupplementaryGroups=adm
WorkingDirectory=/opt/immution
ExecStart=/usr/bin/python3 /opt/immution/immution.py --config /etc/immution/daemon.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
UMask=0027

RuntimeDirectory=immution
RuntimeDirectoryMode=0750
LogsDirectory=immution
LogsDirectoryMode=0770

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/immution /var/log/apache2
ReadWritePaths=/run/immution
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=immution

[Install]
WantedBy=multi-user.target
